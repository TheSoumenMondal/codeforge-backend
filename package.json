{
	"name": "backend",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "node dist/index.js",
		"build": "tsc",
		"dev": "tsc-watch --onSuccess \"node dist/index.js\"",
		"lint": "biome check",
		"format": "biome format --write",
